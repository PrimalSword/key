<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101317">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KEMENT PRINT CAM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Desconectado"
            android:textColor="#B8F7C2"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="E-mail da conta Kement"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#8C949E"
            android:backgroundTint="#D0D5DB" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha da Kement (não é salva)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#8C949E"
            android:backgroundTint="#D0D5DB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/connectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONECTAR / AGUARDAR TOQUE" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ENCERRAR" />
        </LinearLayout>

        <TextView
            android:id="@+id/deviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhum dispositivo selecionado"
            android:textColor="#D5DBE2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/telemetryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bateria: ?   Wi-Fi: ?"
            android:textColor="#AAB4BF"
            android:textSize="12sp" />

        <SurfaceView
            android:id="@+id/videoSurface"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="14dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="P2P: 0 pacotes | vídeo: 0"
            android:textColor="#9BA6B2"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="LOG DE DIAGNÓSTICO"
            android:textStyle="bold"
            android:textColor="#C7D0DA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#A9B8C7"
            android:textSize="10sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
